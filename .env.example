# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Free key from https://www.alphavantage.co/support/#api-key (VWCE prices, BACKLOG P6).
ALPHAVANTAGE_API_KEY=

# Kraken API key with Query permissions only (Kraken sync, BACKLOG P11).
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# Telegram bot for the monthly summary (BACKLOG P26), the same bot as the F1 digest. Only used
# when config.toml has [telegram] monthly_summary = true. The token comes from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
